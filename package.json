{
    "name": "@deroll/monorepo",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "changeset": "changeset",
        "clean": "turbo clean && rm -rf node_modules",
        "dev": "turbo dev --no-cache --continue",
        "lint": "turbo lint",
        "release": "turbo build && node scripts/resolve-workspace-deps.mjs && changeset publish",
        "test": "turbo test",
        "version-packages": "changeset version"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@changesets/cli": "^3.0.2",
        "globals": "^17.12.0",
        "turbo": "^2.10.12"
    },
    "workspaces": [
        "apps/*",
        "packages/*/*"
    ],
    "catalog": {
        "@biomejs/biome": "2.5.12"
    },
    "trustedDependencies": [
        "bufferutil",
        "es5-ext",
        "esbuild",
        "node-gyp-build",
        "sharp",
        "utf-8-validate",
        "vue-demi"
    ],
    "packageManager": "bun@1.4.2",
    "dependencies": {
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "node-addon-api": "^8.9.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "vite": "^8.2.2"
    }
}
