{
    "name": "@deroll/monorepo",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "changeset": "changeset",
        "clean": "turbo clean && rm -rf node_modules",
        "dev": "turbo dev --no-cache --continue",
        "lint": "turbo lint",
        "release": "turbo build && node scripts/resolve-workspace-deps.mjs && changeset publish",
        "test": "turbo test",
        "version-packages": "changeset version"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@changesets/cli": "^2.31.0",
        "globals": "^17.7.0",
        "turbo": "^2.10.1"
    },
    "workspaces": [
        "apps/*",
        "packages/*/*"
    ],
    "catalog": {
        "@biomejs/biome": "2.5.1"
    },
    "trustedDependencies": [
        "bufferutil",
        "es5-ext",
        "esbuild",
        "node-gyp-build",
        "sharp",
        "utf-8-validate",
        "vue-demi"
    ],
    "packageManager": "bun@1.3.12"
}
