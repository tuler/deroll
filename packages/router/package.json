{
    "name": "@deroll/router",
    "version": "2.0.0-alpha.3",
    "repository": {
        "type": "git",
        "url": "https://github.com/tuler/deroll"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "license": "MIT",
    "files": [
        "dist/**"
    ],
    "exports": {
        "import": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "run-s compile",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "compile": "tsup",
        "dev": "tsup --watch",
        "lint": "biome check",
        "test": "vitest",
        "prepack": "run-s build"
    },
    "dependencies": {
        "@deroll/core": "workspace:*",
        "path-to-regexp": "^7.1.0",
        "viem": "^2.47.1"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@deroll/tsconfig": "workspace:*",
        "@types/node": "^25.4.0",
        "npm-run-all": "^4.1.5",
        "openapi-typescript": "^7.8.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18",
        "vitest-mock-extended": "^3.1.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
