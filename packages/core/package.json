{
    "name": "@deroll/core",
    "version": "2.0.0-alpha.0",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "license": "MIT",
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "run-s codegen compile",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "codegen": "ts-node schema.ts",
        "compile": "tsup",
        "dev": "tsup --watch",
        "prepack": "run-s build"
    },
    "dependencies": {
        "viem": "^2.27.3"
    },
    "devDependencies": {
        "@deroll/tsconfig": "workspace:*",
        "@types/node": "^22.14.1",
        "npm-run-all": "^4",
        "openapi-typescript": "^7.6.1",
        "ts-node": "^10.9.2",
        "tsup": "^8.4.0",
        "typescript": "^5.8.3",
        "vitest": "^3.1.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
