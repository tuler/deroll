{
    "name": "@deroll/cm",
    "version": "0.2.0-alpha.2",
    "description": "Cartesi Machine Node.js bindings",
    "repository": {
        "type": "git",
        "url": "https://github.com/tuler/deroll"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "require": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "install": "node scripts/install.cjs",
        "build": "tsup",
        "build:native": "node-gyp rebuild",
        "package:platform": "node scripts/package-platform.mjs",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf build",
        "lint": "biome check",
        "lint:ci": "biome ci",
        "test:integration": "vitest",
        "prepack": "run-s build"
    },
    "keywords": [
        "cartesi",
        "bindings",
        "node.js"
    ],
    "author": "Danilo Tuler",
    "license": "Apache-2.0",
    "dependencies": {
        "node-addon-api": "^8.3.0",
        "node-gyp-build": "^4.8.4"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@deroll/tsconfig": "workspace:*",
        "@types/node": "^26",
        "node-gyp": "^13.0.0",
        "npm-run-all": "^4.1.5",
        "tsup": "^8.5.0",
        "tsx": "^4.20.3",
        "typescript": "^6.0.3",
        "viem": "^2.33.0",
        "vitest": "^4.1.9"
    },
    "files": [
        "dist",
        "binding.gyp",
        "src/addon.cc",
        "src/slirp-stubs.c",
        "scripts/install.cjs",
        "scripts/find-cartesi.cjs"
    ],
    "binary": {
        "napi_versions": [
            8
        ]
    },
    "publishConfig": {
        "access": "public"
    }
}
