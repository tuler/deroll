{
    "name": "@deroll/wallet",
    "version": "2.0.0-alpha.3",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "license": "MIT",
    "files": [
        "dist/**"
    ],
    "exports": {
        "import": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "dev": "tsdown --watch",
        "lint": "biome check",
        "prepack": "run-s build",
        "test": "vitest"
    },
    "dependencies": {
        "@cartesi/viem": "2.0.0-alpha.28",
        "@deroll/core": "workspace:*",
        "viem": "^2.33.1"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@deroll/tsconfig": "workspace:*",
        "@vitest/coverage-istanbul": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "npm-run-all": "^4.1.5",
        "tsdown": "^0.13.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    }
}
