{
    "name": "@deroll/cm",
    "version": "0.2.0-alpha.0",
    "description": "Cartesi Machine Node.js bindings",
    "repository": {
        "type": "git",
        "url": "https://github.com/tuler/deroll"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "require": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "lint": "biome check",
        "lint:ci": "biome ci",
        "test:integration": "vitest",
        "prepack": "run-s build"
    },
    "keywords": [
        "cartesi",
        "bindings",
        "node.js"
    ],
    "author": "Danilo Tuler",
    "license": "Apache-2.0",
    "dependencies": {
        "koffi": "^2.12.2"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "^24.1.0",
        "npm-run-all": "^4.1.5",
        "tsup": "^8.5.0",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3",
        "viem": "^2.33.0",
        "vitest": "^3.2.4"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    }
}
