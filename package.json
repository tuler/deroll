{
    "name": "@deroll/monorepo",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "changeset": "changeset",
        "clean": "turbo clean && rm -rf node_modules",
        "dev": "turbo dev --no-cache --continue",
        "lint": "turbo lint",
        "release": "turbo build && node scripts/resolve-workspace-deps.mjs && changeset publish",
        "test": "turbo test",
        "version-packages": "changeset version"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@changesets/cli": "^3.0.3",
        "globals": "^17.13.0",
        "turbo": "^2.11.8"
    },
    "workspaces": [
        "apps/*",
        "packages/*/*"
    ],
    "catalog": {
        "@biomejs/biome": "2.5.15"
    },
    "trustedDependencies": [
        "bufferutil",
        "es5-ext",
        "esbuild",
        "node-gyp-build",
        "sharp",
        "utf-8-validate",
        "vue-demi"
    ],
    "packageManager": "bun@1.4.3",
    "dependencies": {
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "node-addon-api": "^8.9.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "vite": "^8.3.4"
    }
}
