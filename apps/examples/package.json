{
    "name": "@deroll/examples",
    "version": "2.0.0-alpha.14",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/tuler/deroll"
    },
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "dev": "tsup --watch",
        "dev:abi": "CMT_INPUTS=\"0:0.bin\" tsx src/abi.ts",
        "dev:echo": "CMT_INPUTS=\"0:0.bin\" tsx src/echo.ts",
        "dev:inspect": "CMT_INPUTS=\"0:0.bin\" tsx src/inspect.ts",
        "dev:minimal": "CMT_INPUTS=\"0:0.bin\" tsx src/minimal.ts",
        "dev:wallet": "CMT_INPUTS=\"0:0.bin\" tsx src/wallet.ts",
        "dev:withdraw": "CMT_INPUTS=\"0:0.bin\" tsx src/withdraw.ts",
        "lint": "biome check"
    },
    "bin": {
        "deroll-example-abi": "dist/abi.js",
        "deroll-example-echo": "dist/echo.js",
        "deroll-example-inspect": "dist/inspect.js",
        "deroll-example-minimal": "dist/minimal.js",
        "deroll-example-wallet": "dist/wallet.js",
        "deroll-example-withdraw": "dist/withdraw.js"
    },
    "files": [
        "dist/**"
    ],
    "dependencies": {
        "@cartesi/rollup": "1.0.0-alpha.1",
        "@deroll/wallet": "workspace:*",
        "viem": "^2.56.3"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@deroll/tsconfig": "workspace:*",
        "@types/node": "^26",
        "tsup": "^8.5.1",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0"
    }
}
