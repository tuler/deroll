{
    "name": "@deroll/wallet",
    "version": "2.0.0-alpha.10",
    "repository": {
        "type": "git",
        "url": "https://github.com/tuler/deroll"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "license": "MIT",
    "files": [
        "dist/**"
    ],
    "exports": {
        "import": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "dev": "tsup --watch",
        "lint": "biome check",
        "prepack": "run-s build",
        "test": "vitest"
    },
    "dependencies": {
        "@cartesi/codec": "1.0.0-alpha.5",
        "viem": "^2.57.5"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@cartesi/rollup": "1.0.0-alpha.3",
        "@deroll/tsconfig": "workspace:*",
        "@types/node": "^26.6.5",
        "@vitest/coverage-istanbul": "^5.0.4",
        "@vitest/ui": "^5.0.4",
        "npm-run-all": "^4.1.5",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^5.0.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@cartesi/rollup": "1.0.0-alpha.3"
    }
}
