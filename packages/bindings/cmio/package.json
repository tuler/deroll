{
    "name": "@deroll/cmio",
    "version": "0.2.0-alpha.4",
    "description": "Node.js bindings for libcmt, the Cartesi Machine guest rollup library",
    "keywords": [
        "cartesi",
        "rollups",
        "libcmt",
        "riscv64"
    ],
    "license": "Apache-2.0",
    "author": "Cartesi and individual authors (see AUTHORS)",
    "repository": {
        "type": "git",
        "url": "https://github.com/tuler/deroll"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "require": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "AUTHORS",
        "binding.gyp",
        "dist/",
        "src/",
        "prebuilds/",
        "deps/machine-guest-tools/sys-utils/libcmt/include/",
        "deps/machine-guest-tools/sys-utils/libcmt/src/"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "install": "node-gyp-build",
        "build": "tsup",
        "build:native": "node-gyp rebuild",
        "prebuild:native": "prebuildify --napi --strip",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf build",
        "dev": "tsup --watch",
        "lint": "biome check",
        "lint:ci": "biome ci",
        "test": "run-s build test:mock",
        "test:mock": "node --test \"test/*.test.mjs\"",
        "check:package": "attw --pack .",
        "prepack": "run-s build"
    },
    "dependencies": {
        "node-addon-api": "^8.3.0",
        "node-gyp-build": "^4.8.4"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.3",
        "@biomejs/biome": "catalog:",
        "@deroll/tsconfig": "workspace:*",
        "@types/node": "^26",
        "node-gyp": "^13.0.0",
        "npm-run-all": "^4.1.5",
        "prebuildify": "^6.0.1",
        "tsup": "^8.5.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=18"
    },
    "binary": {
        "napi_versions": [
            8
        ]
    }
}
