{
    "name": "@deroll/core",
    "version": "2.0.0-alpha.1",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "license": "MIT",
    "files": [
        "dist/**"
    ],
    "exports": {
        "import": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "run-s codegen compile",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "codegen": "tsx schema.ts",
        "compile": "tsdown",
        "dev": "tsdown --watch",
        "lint": "biome check",
        "prepack": "run-s build"
    },
    "dependencies": {
        "viem": "^2.33.1"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@deroll/tsconfig": "workspace:*",
        "@types/node": "^24.1.0",
        "npm-run-all": "^4",
        "openapi-typescript": "^7.8.0",
        "tsdown": "^0.13.0",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    }
}
