{
    "name": "@deroll/decoder",
    "version": "0.2.0-alpha.1",
    "description": "Typed toolkit for writing Cartesi Node Explorer payload decoders",
    "repository": {
        "type": "git",
        "url": "https://github.com/tuler/deroll"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist/index.js",
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rm -rf dist && bun build src/index.ts --target=browser --format=esm --outdir dist",
        "prepublishOnly": "bun run build"
    }
}
